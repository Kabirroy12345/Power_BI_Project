      {
        "name": "_Measures",
        "columns": [
          {
            "name": "MeasurePlaceholder",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "MeasurePlaceholder"
          }
        ],
        "measures": [
          {
            "name": "Availability",
            "expression": "DIVIDE(SUM(fact_production[actual_run_time_min]), SUM(fact_production[planned_production_time_min]), 0)",
            "formatString": "0.0%",
            "displayFolder": "01. Core OEE"
          },
          {
            "name": "Performance Rate",
            "expression": "DIVIDE(SUMX(fact_production, fact_production[ideal_cycle_time_sec] * fact_production[total_units_produced]), SUM(fact_production[actual_run_time_min]) * 60, 0)",
            "formatString": "0.0%",
            "displayFolder": "01. Core OEE"
          },
          {
            "name": "Quality Rate",
            "expression": "DIVIDE(SUM(fact_production[good_units]), SUM(fact_production[total_units_produced]), 0)",
            "formatString": "0.0%",
            "displayFolder": "01. Core OEE"
          },
          {
            "name": "OEE",
            "expression": "VAR _Availability = [Availability] VAR _Performance = [Performance Rate] VAR _Quality = [Quality Rate] RETURN _Availability * _Performance * _Quality",
            "formatString": "0.0%",
            "displayFolder": "01. Core OEE"
          },
          {
            "name": "Total Units",
            "expression": "SUM(fact_production[total_units_produced])",
            "formatString": "#,0",
            "displayFolder": "02. Production"
          },
          {
            "name": "Good Units",
            "expression": "SUM(fact_production[good_units])",
            "formatString": "#,0",
            "displayFolder": "02. Production"
          },
          {
            "name": "Defect Units",
            "expression": "SUM(fact_production[defect_units])",
            "formatString": "#,0",
            "displayFolder": "02. Production"
          },
          {
            "name": "Scrap Rate",
            "expression": "DIVIDE([Defect Units], [Total Units], 0)",
            "formatString": "0.00%",
            "displayFolder": "02. Production"
          },
          {
            "name": "Production Value",
            "expression": "SUMX(fact_production, fact_production[good_units] * RELATED(dim_product[unit_cost_usd]))",
            "formatString": "$#,0",
            "displayFolder": "02. Production"
          },
          {
            "name": "Downtime Hours",
            "expression": "DIVIDE(SUM(fact_production[downtime_min]), 60, 0)",
            "formatString": "#,0.0",
            "displayFolder": "03. Downtime"
          },
          {
            "name": "Downtime %",
            "expression": "DIVIDE(SUM(fact_production[downtime_min]), SUM(fact_production[planned_production_time_min]), 0)",
            "formatString": "0.00%",
            "displayFolder": "03. Downtime"
          },
          {
            "name": "Unplanned Downtime",
            "expression": "DIVIDE(CALCULATE(SUM(fact_production[downtime_min]), NOT(fact_production[downtime_reason] IN {\"Planned Maintenance\", \"No Downtime\"})), 60, 0)",
            "formatString": "#,0.0",
            "displayFolder": "03. Downtime"
          },
          {
            "name": "OEE PM",
            "expression": "CALCULATE([OEE], DATEADD(dim_date[date], -1, MONTH))",
            "formatString": "0.0%",
            "displayFolder": "04. Time Intelligence"
          },
          {
            "name": "OEE MoM Change",
            "expression": "VAR _Current = [OEE] VAR _Previous = [OEE PM] RETURN IF(NOT(ISBLANK(_Previous)), _Current - _Previous, BLANK())",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "04. Time Intelligence"
          },
          {
            "name": "OEE MoM %",
            "expression": "DIVIDE([OEE MoM Change], [OEE PM], BLANK())",
            "formatString": "+0.0%;-0.0%;0.0%",
            "displayFolder": "04. Time Intelligence"
          },
          {
            "name": "Good Units YTD",
            "expression": "CALCULATE([Good Units], DATESYTD(dim_date[date]))",
            "formatString": "#,0",
            "displayFolder": "04. Time Intelligence"
          },
          {
            "name": "Running Total Units",
            "expression": "CALCULATE([Good Units], FILTER(ALL(dim_date), dim_date[date] <= MAX(dim_date[date])))",
            "formatString": "#,0",
            "displayFolder": "04. Time Intelligence"
          },
          {
            "name": "Total Energy kWh",
            "expression": "SUM(fact_production[energy_kwh])",
            "formatString": "#,0.0",
            "displayFolder": "05. Reliability & Energy"
          },
          {
            "name": "Energy per Unit",
            "expression": "DIVIDE([Total Energy kWh], [Good Units], 0)",
            "formatString": "0.000",
            "displayFolder": "05. Reliability & Energy"
          },
          {
            "name": "Energy Efficiency",
            "expression": "DIVIDE([Good Units], [Total Energy kWh], 0)",
            "formatString": "0.00",
            "displayFolder": "05. Reliability & Energy"
          },
          {
            "name": "Failure Count",
            "expression": "CALCULATE(COUNTROWS(fact_production), fact_production[downtime_reason] = \"Equipment Failure\")",
            "formatString": "#,0",
            "displayFolder": "05. Reliability & Energy"
          },
          {
            "name": "MTBF Hours",
            "expression": "DIVIDE(SUM(fact_production[actual_run_time_min]) / 60, [Failure Count], SUM(fact_production[actual_run_time_min]) / 60)",
            "formatString": "#,0.0",
            "displayFolder": "05. Reliability & Energy"
          },
          {
            "name": "OEE Status",
            "expression": "SWITCH(TRUE(), [OEE] >= 0.85, \"World Class\", [OEE] >= 0.75, \"Good\", [OEE] >= 0.65, \"Needs Improvement\", \"Critical\")",
            "displayFolder": "06. KPI Formatting"
          },
          {
            "name": "OEE Color",
            "expression": "SWITCH(TRUE(), [OEE] >= 0.85, \"#00B140\", [OEE] >= 0.75, \"#FFC72C\", [OEE] >= 0.65, \"#F97316\", \"#E4002B\")",
            "displayFolder": "06. KPI Formatting"
          },
          {
            "name": "OEE Trend Arrow",
            "expression": "IF([OEE MoM Change] > 0, \"\u25b2 \" & FORMAT(ABS([OEE MoM Change]) * 100, \"0.0\") & \"%\", \"\u25bc \" & FORMAT(ABS([OEE MoM Change]) * 100, \"0.0\") & \"%\")",
            "displayFolder": "06. KPI Formatting"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": "ROW(\"MeasurePlaceholder\", 1)"
            }
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "rel_fact_date",
        "fromTable": "fact_production",
        "fromColumn": "date_key",
        "toTable": "dim_date",
        "toColumn": "date_key",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "rel_fact_machine",
        "fromTable": "fact_production",
        "fromColumn": "machine_id",
        "toTable": "dim_machine",
        "toColumn": "machine_key",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "rel_fact_product",
        "fromTable": "fact_production",
        "fromColumn": "product_id",
        "toTable": "dim_product",
        "toColumn": "product_key",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "rel_fact_shift",
        "fromTable": "fact_production",
        "fromColumn": "shift_id",
        "toTable": "dim_shift",
        "toColumn": "shift_key",
        "crossFilteringBehavior": "oneDirection"
      },
      {
        "name": "rel_fact_operator",
        "fromTable": "fact_production",
        "fromColumn": "operator_id",
        "toTable": "dim_operator",
        "toColumn": "operator_key",
        "crossFilteringBehavior": "oneDirection"
      }
    ]
  }
}