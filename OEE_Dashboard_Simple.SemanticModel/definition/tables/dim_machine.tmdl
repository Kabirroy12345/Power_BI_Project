	partition dim_machine = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_machine.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Removed Other Columns" = Table.SelectColumns(#"Promoted Headers", {"machine_id", "machine_type", "production_line", "manufacturer"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Removed Other Columns", {{"machine_id", type text}, {"machine_type", type text}, {"production_line", type text}, {"manufacturer", type text}}, "en-US")
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

