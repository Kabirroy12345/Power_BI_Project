model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder", "fact_production", "dim_date", "dim_machine", "dim_product", "dim_shift", "_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table fact_production
ref table dim_date
ref table dim_machine
ref table dim_product
ref table dim_shift
ref table _Measures

ref cultureInfo en-US

